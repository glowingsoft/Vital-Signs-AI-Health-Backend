DB_HOST=
DB_PORT=
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=
DB_NODE_USER=
DB_NODE_PASSWORD=
REDIS_URL=
MAX_JOB_ATTEMPTS=
FAILED_ENQUEUE_FILE=
DB_ADMIN_PASSWORD=
DATABASE_URL=
JWT_SECRET=
USE_BEDROCK=false
AWS_REGION=us-west-2

# ---------- Versions (docker-compose.yml) ----------
# Which version this folder runs: names the URL prefix (/v1), the containers and the Compose project.
API_VERSION=v1
# true only for the NEWEST version: it runs the migrations on the shared database (VERSIONS.md).
RUN_MIGRATIONS=true

# ---------- Optional, local Docker only ----------
# Keep your existing local database: the volume of the old all-in-one setup on your Mac.
# PGDATA_VOLUME=vital-signs-ai-health-backend_pgdata
# Other ports if the defaults are taken (gateway 80, Postgres 5433, Redis 6380; a 2nd version needs its own REDIS_PORT).
# GATEWAY_PORT=80
# POSTGRES_PORT=5433
# REDIS_PORT=6380
