# API gateway for the AWS server (HTTPS only). The local Mac setup uses gateway/nginx.conf instead.
# This is a template: the nginx image replaces ${DOMAIN} with the DOMAIN value from .env when the
# container starts and writes the result to /etc/nginx/conf.d/default.conf.
#
# Port 80 never serves data: it only redirects to HTTPS.
# The certificate is created on the server with "certbot certonly" and mounted from /etc/letsencrypt.
# Port 443 accepts TLS 1.3 only (Proposal M1 security baseline, Spec: TLS 1.3 in transit).

# Docker's internal DNS. With a variable in proxy_pass, nginx looks up "orchestrator" again every 10 s
# instead of once at startup, so it keeps working after the orchestrator container restarts with a new IP.
resolver 127.0.0.11 valid=10s ipv6=off;

# Rate limit per client IP: 10 requests/second. 10m of memory holds about 160,000 IPs.
limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;

# Which 404 page to send: browsers ask for text/html and get the designed page,
# apps and curl get JSON in the same shape as FastAPI's own errors ({"detail": ...}).
map $http_accept $not_found_page {
    default        /errors/404.json;
    "~*text/html"  /errors/404.html;
}

# ---------- Port 80: redirect only ----------
server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    # Everything else goes to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- Port 443: the API, TLS 1.3 only ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Do not show the nginx version in headers and error pages.
    server_tokens off;

    # Let's Encrypt certificate, created and renewed by certbot on the server.
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Tell browsers to use HTTPS only for this domain for the next year.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Image uploads travel in the request body.
    client_max_body_size 10m;

    # Up to 20 requests above the rate are let through at once (burst); anything more gets 429.
    limit_req zone=per_ip burst=20 nodelay;
    limit_req_status 429;

    set $orchestrator http://orchestrator:8000;

    # Tell the orchestrator who the real client is (it only sees the gateway's IP otherwise).
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The orchestrator gives the motors 2.5 s (MOTOR_TIMEOUT_SECONDS), then queues the result and answers.
    # 5 s leaves room for that, so the orchestrator always answers before nginx gives up.
    proxy_connect_timeout 2s;
    proxy_read_timeout    5s;

    location = /health {
        proxy_pass $orchestrator;
    }

    location /ai/ {
        # The orchestrator verifies the NestJS access token itself (python_auth/).
        proxy_pass $orchestrator;
    }

    # Everything else, including /motor/*, /docs and /openapi.json.
    location / {
        return 404;
    }

    # Custom 404 pages from gateway/src (mounted at /usr/share/nginx/errors).
    error_page 404 $not_found_page;

    # "internal" = only nginx can use these files (for error_page), never a direct request.
    location ^~ /errors/ {
        internal;
        root /usr/share/nginx;
        ssi on;
        ssi_types application/json;
        add_header Cache-Control "no-store" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
